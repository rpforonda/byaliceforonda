{
  "name": "author-site",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "wasm": "cargo build --release --target wasm32-unknown-unknown --manifest-path cosmic-dash/Cargo.toml && wasm-bindgen --target web --no-typescript --out-dir cosmic-dash/pkg cosmic-dash/target/wasm32-unknown-unknown/release/cosmic_dash.wasm",
    "predev": "npm run wasm",
    "dev": "vite dev",
    "prebuild": "npm run wasm",
    "build": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/enhanced-img": "^1.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "svelte": "^5.57.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.0.12"
  },
  "imports": {
    "#lib/*": "./src/lib/*",
    "#cosmic-dash": "./cosmic-dash/pkg/cosmic_dash.js"
  }
}
